+package com.gymflow.auth
+
+import androidx.compose.ui.test.hasSetTextAction
+import androidx.compose.ui.test.hasText
+import androidx.compose.ui.test.junit4.createAndroidComposeRule
+import androidx.compose.ui.test.onAllNodesWithText
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.performTextInput
+import androidx.lifecycle.ViewModelProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.google.android.gms.tasks.Tasks
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.auth.FirebaseAuthException
+import com.gymflow.GoogleFirebaseSignIn
+import com.gymflow.GymFlowViewModel
+import com.gymflow.MainActivity
+import com.gymflow.R
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import org.junit.AfterClass
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Ignore
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.RuleChain
+import org.junit.rules.TestWatcher
+import org.junit.runner.Description
+import org.junit.runner.RunWith
+
+/**
+ * Ciclo de vida del login con la MainActivity REAL, la pantalla real y el código real de producción
+ * (GoogleFirebaseSignIn, AuthNavigation, SessionPolicy) contra los emuladores de Firebase.
+ *
+ * EJECUCIÓN: SOLO esta clase, en su propio proceso de instrumentación, en el AVD GymFlow_Test_API35 y con el PC sin
+ * Internet (ver el procedimiento): -e class com.gymflow.auth.AuthLifecycleTest. No hay omisiones: si falta
+ * algo del aislamiento, FALLA («EJECUCIÓN BLOQUEADA»). Al final se exige que se ejecutaran TODAS las pruebas activas.
+ */
+@RunWith(AndroidJUnit4::class)
+class AuthLifecycleTest {
+
+    companion object {
+        private val terminadasOk = AtomicInteger(0)
+
+        /** H5: si alguna prueba activa no se ejecutó o no terminó bien (omisión, filtro, fallo), la clase FALLA. */
+        @AfterClass @JvmStatic fun todasLasPruebasActivasSeEjecutaron() {
+            val activas = AuthLifecycleTest::class.java.methods.count {
+                it.isAnnotationPresent(Test::class.java) && !it.isAnnotationPresent(Ignore::class.java)
+            }
+            assertEquals("pruebas activas que terminaron bien", activas, terminadasOk.get())
+        }
+    }
+
+    @get:Rule val contador = object : TestWatcher() {
+        override fun succeeded(description: Description) { terminadasOk.incrementAndGet() }
+    }
+
+    private val compose = createAndroidComposeRule<MainActivity>()
+    // El aislamiento (emuladores) se verifica y configura ANTES de lanzar la Activity.
+    @get:Rule val chain: RuleChain = RuleChain.outerRule(AuthEmulatorRule()).around(compose)
+
+    private val ctx get() = InstrumentationRegistry.getInstrumentation().targetContext
+    private val auth get() = FirebaseAuth.getInstance()
+    private val email = "gymflow-test@example.invalid"
+    private val password = "Test-1234-abc"
+
+    private fun enLogin() = compose.onAllNodesWithText(ctx.getString(R.string.app_tagline)).fetchSemanticsNodes().isNotEmpty()
+    private fun enInicio() = compose.onAllNodesWithText("Inicio").fetchSemanticsNodes().isNotEmpty()
+    private fun esperarInicio() = compose.waitUntil(20_000) { enInicio() }
+    private fun esperarLogin() = compose.waitUntil(20_000) { enLogin() }
+    private fun recordarme() = AuthEmulator.prefs(ctx).getBoolean("remember_me", false)
+
+    /** Evidencia: la Activity es REALMENTE una instancia nueva. */
+    private fun recrear() {
+        val antes = compose.activity
+        compose.activityRule.scenario.recreate(); compose.waitForIdle()
+        assertTrue("la Activity debía ser una instancia nueva", compose.activity !== antes)
+    }
+
+    /**
+     * Sesión de Google SIMULADA con el código real de producción. Con esperar=true exige la evidencia de que la
+     * operación se hizo: el SDK completó el inicio de sesión Y el emulador conoce al usuario.
+     */
+    private fun sesionGoogle(sub: String = "sub-1", esperar: Boolean = true) {
+        val correo = "$sub@example.invalid"
+        InstrumentationRegistry.getInstrumentation().runOnMainSync {
+            GoogleFirebaseSignIn.start(auth, ctx.applicationContext, AuthEmulator.fakeGoogleIdToken(sub, correo))
+        }
+        if (esperar) esperarSesionDe(correo)
+    }
+
+    private fun esperarSesionDe(correo: String) {
+        compose.waitUntil(20_000) { auth.currentUser?.email == correo }
+        assertTrue("el emulador debe conocer a $correo (la operación llegó al emulador)", AuthEmulator.emulatorHasEmail(correo))
+    }
+
+    private fun escribir(etiqueta: String, texto: String) =
+        compose.onNode(hasSetTextAction() and hasText(etiqueta)).performTextInput(texto)
+
+    private fun loginPorCorreo(pass: String, recordar: Boolean) {
+        escribir("Email", email); escribir("Contraseña", pass)
+        if (recordar) compose.onNodeWithText("Recordar sesión").performClick()
+        compose.onNodeWithText("ENTRAR").performClick()
+    }
+
+    private fun viewModel() = ViewModelProvider(compose.activity.viewModelStore, ViewModelProvider.NewInstanceFactory())[GymFlowViewModel::class.java]
+
+    // 0: el aislamiento se verificó de verdad en este proceso (aparece como prueba propia en el informe)
+    @Test fun aislamiento_verificadoAntesDeLanzarLaActividad() {
+        assertTrue("dispositivo emulado", Evidence.deviceVerified)
+        assertTrue("proceso aislado", Evidence.isolatedProcessVerified)
+        assertTrue("red sin salida", Evidence.networkIsolationVerified)
+        assertTrue("Firestore redirigido", Evidence.firestoreRedirected)
+        assertTrue("Auth redirigido (entrada canario)", Evidence.authRedirectProved)
+    }
+
+    // 0b: el token JSON falso NO se presupone aceptado: se comprueba a nivel REST, con mensaje específico
+    @Test fun preflight_elEmuladorAceptaElTokenFalsoDeGoogle() {
+        val r = AuthEmulator.fakeGoogleTokenResponse()
+        assertTrue("El emulador no aceptó el token falso (respuesta: $r)", r.contains("\"idToken\"") && r.contains("\"localId\""))
+    }
+
+    // 1 + 7: LOGIN → HOME con sesión simulada, y remember_me
+    @Test fun sesionGoogleSimulada_llevaDeLoginAInicio_yGuardaRecordarme() {
+        esperarLogin(); assertNull(auth.currentUser)
+        sesionGoogle()
+        esperarInicio()
+        assertTrue(recordarme())
+        assertEquals("el SDK debe haber hablado con el emulador, no con la nube", 1, AuthEmulator.emulatorUserCount())
+    }
+
+    // 2: recreación real ANTES de recibir la sesión
+    @Test fun recrearAntesDeRecibirLaSesion_laNuevaActivityAbreInicio() {
+        esperarLogin()
+        recrear(); esperarLogin()
+        sesionGoogle()
+        esperarInicio()
+    }
+
+    // 2 (carrera): la sesión llega mientras la Activity se recrea; el orden varía, el resultado no
+    @Test fun sesionQueLlegaMientrasSeRecrea_terminaEnInicio() {
+        esperarLogin()
+        sesionGoogle(esperar = false); recrear()
+        esperarInicio()
+        esperarSesionDe("sub-1@example.invalid")
+        assertTrue(recordarme())
+    }
+
+    // 3 + 8: recreación DESPUÉS de la sesión → se recupera
+    @Test fun recrearDespuesDeLaSesion_conservaInicio() {
+        sesionGoogle(); esperarInicio()
+        recrear()
+        esperarInicio(); assertFalse(enLogin())
+    }
+
+    // 4 (INDIRECTO): no demuestra que el listener anterior se retire; solo que no hay fallo y la nueva composición navega
+    @Test fun recrearYRecibirSesion_laNuevaComposicionNavegaYLaAnteriorNoRompe() {
+        esperarLogin()
+        recrear()
+        sesionGoogle()
+        esperarInicio()
+        assertEquals(1, AuthEmulator.emulatorUserCount())
+    }
+
+    // 5: una NUEVA notificación de sesión (otro usuario) con la pantalla ya en HOME no reinicia la navegación
+    @Test fun sesionDeOtroUsuarioConLaPantallaEnPerfil_noReiniciaLaNavegacion() {
+        sesionGoogle("sub-1"); esperarInicio()
+        compose.onNodeWithText("Perfil").performClick(); compose.waitForIdle()
+        sesionGoogle("sub-2")
+        compose.waitUntil(20_000) { AuthEmulator.emulatorUserCount() == 2 }
+        compose.waitForIdle()
+        assertTrue(enInicio()); assertFalse(enLogin())
+    }
+
+    // 9: cerrar sesión → no se recupera
+    @Test fun cerrarSesion_yRecrear_noRecuperaLaSesion() {
+        sesionGoogle(); esperarInicio()
+        assertNotNull(auth.currentUser)
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { auth.signOut() }
+        recrear(); esperarLogin()
+        assertNull(auth.currentUser)
+    }
+
+    // 9: con sesión pero SIN «recordarme», al (re)crear la Activity se cierra la sesión (política ACTUAL; caracterización)
+    @Test fun conSesionSinRecordarme_alCrearLaActivitySeCierraLaSesion() {
