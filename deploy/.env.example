# Copia este archivo como .env (no lo subas a git) y rellénalo.

# Dominio que apunta a la IP de la VM (p. ej. un subdominio gratis de duckdns.org,
# o sin cuenta: 1-2-3-4.sslip.io con los números de tu IP)
DOMAIN=gymflow.tu-subdominio.duckdns.org

# Puerto HTTPS (443 si está abierto; si no, otro abierto, p. ej. 9001). El 80 debe estar abierto.
HTTPS_PORT=443

# Contraseña de PostgreSQL: larga y aleatoria (p. ej. openssl rand -base64 24)
DB_PASSWORD=cambia-esto

# Proyecto de Firebase de la app (app/google-services.json → project_id)
FIREBASE_PROJECT_ID=fitforge-f1476
